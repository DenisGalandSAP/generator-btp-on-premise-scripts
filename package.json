{
  "name": "@scodigis/generator-btp-on-premise-scripts",
  "displayName": "BTP On-Premise Access",
  "version": "0.8.3",
  "description": "Adds scripts to run and deploy a SAPUI5 / SAP Fiori elements app, or to reach an ABAP system with ABAP Development Tools and ADT MCP servers, through an on-premise SAP BTP destination (cf ssh tunnel to the connectivity proxy).",
  "main": "generators/app/index.js",
  "bin": {
    "btp-on-premise-setup": "bin/btp-setup.js"
  },
  "image": "yeoman.svg",
  "files": [
    "bin",
    "generators",
    "yeoman.svg"
  ],
  "keywords": [
    "yeoman-generator",
    "sap",
    "sapui5",
    "fiori",
    "sapbtp",
    "destination",
    "cloud-foundry",
    "claude-code",
    "abap",
    "adt"
  ],
  "author": "Scodigis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenisGalandSAP/generator-btp-on-premise-scripts.git"
  },
  "homepage": "https://github.com/DenisGalandSAP/generator-btp-on-premise-scripts#readme",
  "bugs": {
    "url": "https://github.com/DenisGalandSAP/generator-btp-on-premise-scripts/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "tsc -p . && node test/run.js && node test/scenarios.js",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@sap-devx/yeoman-ui-types": "^1.25.1",
    "yaml": "^2.9.1",
    "yeoman-generator": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/yeoman-generator": "5.2.14",
    "typescript": "7.0.2",
    "yeoman-environment": "^3.19.3",
    "yeoman-test": "^6.3.0"
  }
}
